---
import { SEORenderer } from '@jjlmoya/utils-shared';
import { pcbTraceWidthImpedanceChecker } from './entry';
import type { KnownLocale } from '../../types';

interface Props { locale?: KnownLocale; }
const { locale = 'en' } = Astro.props;
const loader = pcbTraceWidthImpedanceChecker.i18n[locale as KnownLocale] ?? pcbTraceWidthImpedanceChecker.i18n.en;
const content = loader ? await loader() : null;
---

{content?.seo && content.seo.length > 0 && <SEORenderer content={{ locale, sections: content.seo }} />}
