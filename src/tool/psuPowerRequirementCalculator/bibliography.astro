---
import { Bibliography as SharedBibliography } from '@jjlmoya/utils-shared';
import type { KnownLocale } from '../../types';
import { psuPowerRequirementCalculator } from './index';

interface Props {
  locale?: KnownLocale;
}

const { locale = 'en' } = Astro.props;
const content = await psuPowerRequirementCalculator.i18n[locale]?.() ?? await psuPowerRequirementCalculator.i18n.en?.();
---

{content && content.bibliography.length > 0 && <SharedBibliography links={content.bibliography} />}
