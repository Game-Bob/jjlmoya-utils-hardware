---
import { Bibliography as SharedBibliography } from '@jjlmoya/utils-shared';
import { voltageDividerCalculator } from './index';
import type { KnownLocale } from '../../types';

interface Props {
  locale?: KnownLocale;
}

const { locale = 'en' } = Astro.props;
const content = await voltageDividerCalculator.i18n[locale]?.() ?? await voltageDividerCalculator.i18n.en?.();
if (!content) return null;
---

{content.bibliography?.length > 0 && <SharedBibliography links={content.bibliography} />}
