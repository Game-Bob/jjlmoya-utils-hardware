---
import { SEORenderer } from '@jjlmoya/utils-shared';
import { laptopBatteryRuntime } from './entry';
import type { KnownLocale } from '../../types';

interface Props {
  locale: KnownLocale;
}

const { locale } = Astro.props;
const content = await laptopBatteryRuntime.i18n[locale]?.() ?? await laptopBatteryRuntime.i18n.en?.();
---

{content && content.seo.length > 0 && <SEORenderer content={{ locale, sections: content.seo }} />}
