---
import type { WebcamTesterUI } from './ui';
import './webcam-tester.css';

interface Props {
  ui: WebcamTesterUI;
}

const { ui } = Astro.props;
---

<section
  class="webcam-tester"
  data-webcam-tester
  data-state="idle"
  data-mirror="true"
  data-guide="true"
  data-frame-delivery="pending"
>
  <script is:inline type="application/json" data-webcam-config set:html={JSON.stringify(ui)} />
  <div class="webcam-tester-privacy">
    <span class="webcam-tester-privacy-light" aria-hidden="true"></span>
    <span>{ui.privacyNote}</span>
  </div>

  <div class="webcam-tester-stage" aria-label={ui.stageLabel}>
    <video class="webcam-tester-video" data-camera-video muted playsinline aria-label={ui.stageLabel}></video>
    <div class="webcam-tester-guide" aria-hidden="true">
      <span class="webcam-tester-third webcam-tester-third-vertical-one"></span>
      <span class="webcam-tester-third webcam-tester-third-vertical-two"></span>
      <span class="webcam-tester-third webcam-tester-third-horizontal-one"></span>
      <span class="webcam-tester-third webcam-tester-third-horizontal-two"></span>
      <span class="webcam-tester-focus-ring"></span>
    </div>
    <div class="webcam-tester-corner webcam-tester-corner-top-left" aria-hidden="true"></div>
    <div class="webcam-tester-corner webcam-tester-corner-top-right" aria-hidden="true"></div>
    <div class="webcam-tester-corner webcam-tester-corner-bottom-left" aria-hidden="true"></div>
    <div class="webcam-tester-corner webcam-tester-corner-bottom-right" aria-hidden="true"></div>

    <div class="webcam-tester-permission">
      <div class="webcam-tester-permission-copy">
        <p class="webcam-tester-permission-kicker">{ui.localOnlyLabel}</p>
        <h2>{ui.permissionHeading}</h2>
        <p>{ui.permissionBody}</p>
        <button class="webcam-tester-start" type="button" data-start-camera>
          <span>{ui.startAction}</span>
        </button>
      </div>
      <div class="webcam-tester-iris" aria-hidden="true">
        <span class="webcam-tester-iris-ring"></span>
        <span class="webcam-tester-iris-core"></span>
      </div>
    </div>

    <div class="webcam-tester-live-bar">
      <div class="webcam-tester-live-mark">
        <span class="webcam-tester-live-dot" aria-hidden="true"></span>
        <span>{ui.localOnlyLabel}</span>
      </div>
      <div class="webcam-tester-live-actions">
        <button class="webcam-tester-live-toggle" type="button" data-toggle-mirror aria-pressed="true">
          <span class="webcam-tester-mirror-icon" aria-hidden="true"></span>
          <span>{ui.mirrorAction}</span>
        </button>
        <button class="webcam-tester-live-toggle" type="button" data-toggle-guide aria-pressed="true">
          <span class="webcam-tester-guide-icon" aria-hidden="true"></span>
          <span>{ui.guideAction}</span>
        </button>
        <button class="webcam-tester-stop" type="button" data-stop-camera>
          <span class="webcam-tester-stop-icon" aria-hidden="true"></span>
          <span>{ui.stopAction}</span>
        </button>
      </div>
    </div>

    <div class="webcam-tester-status" role="status" aria-live="polite">
      <span class="webcam-tester-status-wave" aria-hidden="true"></span>
      <span data-status-message>{ui.statusIdle}</span>
    </div>
  </div>

  <div class="webcam-tester-film" aria-label={ui.frameDeliveryLabel}>
    <div class="webcam-tester-metric webcam-tester-metric-format">
      <span>{ui.resolutionLabel}</span>
      <strong data-metric="resolution">{ui.emptyValue}</strong>
      <small><span data-metric="aspect">{ui.emptyValue}</span> · <span data-metric="orientation">{ui.emptyValue}</span></small>
    </div>
    <div class="webcam-tester-metric webcam-tester-metric-frames">
      <span>{ui.configuredFpsLabel}</span>
      <strong data-metric="configured-fps">{ui.emptyValue}</strong>
      <small>{ui.observedFpsLabel}: <span data-metric="observed-fps">{ui.emptyValue}</span></small>
    </div>
    <div class="webcam-tester-metric webcam-tester-metric-delivery">
      <span>{ui.frameDeliveryLabel}</span>
      <strong data-metric="delivery">{ui.framePending}</strong>
    </div>
  </div>

  <div class="webcam-tester-controls" data-camera-picker hidden>
    <div class="webcam-tester-device">
      <span class="webcam-tester-control-label">{ui.deviceLabel}</span>
      <button
        class="webcam-tester-device-trigger"
        type="button"
        data-camera-trigger
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span data-camera-trigger-label>{ui.devicePlaceholder}</span>
        <span class="webcam-tester-chevron" aria-hidden="true"></span>
      </button>
      <div class="webcam-tester-device-options" data-camera-options role="listbox" hidden></div>
    </div>
  </div>

  <div class="webcam-tester-limit">
    <span class="webcam-tester-limit-mark" aria-hidden="true">i</span>
    <div>
      <strong>{ui.limitHeading}</strong>
      <p>{ui.limitBody}</p>
    </div>
  </div>
</section>

<script>
  import { initWebcamTester } from './controller';
  import type { WebcamTesterUI } from './ui';

  document.querySelectorAll<HTMLElement>('[data-webcam-tester]').forEach((root) => {
    if (root.dataset.initialized === 'true') return;
    const config = root.querySelector<HTMLScriptElement>('[data-webcam-config]');
    if (!config?.textContent) return;
    root.dataset.initialized = 'true';
    initWebcamTester(root, JSON.parse(config.textContent) as WebcamTesterUI);
  });
</script>
